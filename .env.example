# Reference only: set these in your hosting dashboard or PowerShell.
# This project does NOT automatically load .env files.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
BUS_HOST=0.0.0.0
BUS_REQUIRE_DATABASE=1
# Hosting providers usually set PORT automatically.
# BUS_PORT=8000
# Use only behind your hosting platform HTTPS proxy:
BUS_HTTPS=1
# Initial passwords apply only to new accounts in a new database:
BUS_ADMIN_PASSWORD=CHOOSE_A_PRIVATE_PASSWORD
BUS_DRIVER_PASSWORD=CHOOSE_A_DIFFERENT_PRIVATE_PASSWORD
